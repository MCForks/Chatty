{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "6a972197df514e5c306f89afbe68b1a4279baee9",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "build",
      "section": "Build System"
    },
    {
      "type": "ci",
      "section": "CI/CD"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "chore",
      "section": "Maintenance"
    }
  ],
  "packages": {
    ".": {
      "package-name": "Chatty",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
